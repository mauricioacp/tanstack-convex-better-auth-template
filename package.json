{
	"name": "acme",
	"version": "0.1.0",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^5",
			"convex": "^1.31.2",
			"better-auth": "1.4.9",
			"@convex-dev/better-auth": "^0.10.9",
			"alchemy": "^0.82.1"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F @acme/backend dev",
		"dev:setup": "turbo -F @acme/backend dev:setup",
		"deploy": "turbo -F @acme/infra deploy",
		"destroy": "turbo -F @acme/infra destroy",
		"format": "biome format .",
		"format:write": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check --write .",
		"check:fix": "biome check --write .",
		"prepare": "husky",
		"release": "commit-and-tag-version",
		"release:minor": "commit-and-tag-version --release-as minor",
		"release:major": "commit-and-tag-version --release-as major",
		"release:patch": "commit-and-tag-version --release-as patch",
		"release:dry": "commit-and-tag-version --dry-run",
		"release:first": "commit-and-tag-version --first-release",
		"init": "bun run scripts/init.ts",
		"analyze-bundle": "bun run scripts/analyze-bundle.ts"
	},
	"dependencies": {
		"@acme/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@acme/config": "workspace:*",
		"@biomejs/biome": "^2.2.0",
		"@cloudflare/workers-types": "^4.20251213.0",
		"@commitlint/cli": "^20.4.1",
		"@commitlint/config-conventional": "^20.4.1",
		"@inlang/paraglide-js": "^2.10.0",
		"commit-and-tag-version": "^12.6.1",
		"husky": "^9.1.7",
		"turbo": "^2.6.3",
		"typescript": "catalog:",
		"web": "workspace:*"
	},
	"packageManager": "bun@1.3.5"
}
